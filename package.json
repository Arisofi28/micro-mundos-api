{
  "name": "micro-mundos-api",
  "version": "1.0.0",
  "description": "API REST temática de Micro-Mundos Creativos construida con Node.js, Express y TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "npm run typecheck && npm run build"
  },
  "keywords": [
    "typescript",
    "express",
    "rest-api",
    "micro-worlds"
  ],
  "author": "Ariana Puerta",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}